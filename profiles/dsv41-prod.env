# dsv4.1-flash production profile (4x GB10, TP=4/EP=4)
# Starting values; every knob re-derived on live hardware (Phase 8).

TP_SIZE=4
EP_SIZE=4
NNODES=4
MODEL_PATH=$HOME/models/llm/dsv41/DeepSeek-V4.1-Flash
PORT=30000

# --- context / capacity -----------------------------------------------
CONTEXT_LENGTH=524288            # dual-profile: 512k prod
MAX_TOTAL_TOKENS=1100000          # realistic w/ graphs (~81.6 GiB weights/rank)
MAX_RUNNING_REQUESTS=8
CHUNKED_PREFILL_SIZE=4096
MEM_FRACTION_STATIC=0.80

# --- speculative decoding ---------------------------------------------
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
ADAPTIVE_VERIFICATION=0           # OFF: padded spec batches hang SM120 sparse MLA

# --- engram file store (our core contribution) ------------------------
DSV41_ENGRAM_FILE_STORE=1
DSV41_MODEL_PATH=$HOME/models/llm/dsv41/DeepSeek-V4.1-Flash

# --- runtime pinning --------------------------------------------------
GPU_STATE_LOCK=1                  # probe/lock GB10 fast state pre-launch
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False   # NEVER True on GB10 (NaN logits)
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0              # atomic finalize nondeterministic
# Sparse-MLA backend: flashinfer decode + Triton prefill (hybrid installed by
# the adapter at import — the adapter replaces the broken flashinfer prefill
# path with upstream's Triton kernel; decode keeps the fast flashinfer kernel).
SGLANG_SM120_FLASHMLA_BACKEND=flashinfer

EXTRA_SGLANG_ARGS="--fp8-gemm-backend cutlass --watchdog-timeout 1800"
